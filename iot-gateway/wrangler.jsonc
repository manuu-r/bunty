{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iot-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bunty.underdogthinkers.com",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DEVICES_DB",
      "database_name": "iot-gateway-db",
      "database_id": "3369b07b-d17b-4323-83f6-a1a023bfc995",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "DEVICE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DEVICE_SESSION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "iot-gateway",
    "AI_MODEL": "anthropic/claude-haiku-4.5",
    "STT_MODEL": "@cf/deepgram/flux",
    "BATCH_STT_MODEL": "@cf/openai/whisper",
    "TTS_MODEL": "@cf/deepgram/aura-1",
    "TTS_SPEAKER": "arcas",
    "AI_GATEWAY_LOGS": "false",
    "DEFAULT_MAX_OUTPUT_TOKENS": "256",
    "GLOBAL_MAX_OUTPUT_TOKENS": "512",
    "VOICE_MAX_OUTPUT_TOKENS": "512",
    "MAX_REQUEST_BYTES": "8192",
    "MAX_TRANSCRIPT_CHARS": "4000",
    "MAX_TTS_CHARS": "3000",
    "LIVE_AUDIO_SAMPLE_RATE": "16000",
    "LIVE_MAX_SESSION_SECONDS": "300",
    "LIVE_MAX_AUDIO_SECONDS": "300",
    "LIVE_MAX_FRAME_BYTES": "65536",
    "LIVE_MAX_TURNS": "20",
    "LIVE_PLAYBACK_ACK_TIMEOUT_MS": "30000",
    "STT_EOT_THRESHOLD": "0.9",
    "STT_EAGER_EOT_THRESHOLD": "0.7",
    "STT_EOT_TIMEOUT_MS": "60000",
    "TURN_DETECTION_MODEL": "@cf/pipecat-ai/smart-turn-v2",
    "TURN_DETECTION_THRESHOLD": "0.65",
    "TURN_DETECTION_AUDIO_SECONDS": "12",
    "TURN_DETECTION_FALLBACK_MS": "1500",
    "LIVE_HISTORY_TURNS": "6",
    "SYSTEM_PROMPT": "You are Bunty, an expressive, cute, silent pantomime desk robot. The user calls you 'Hey Buddy' or 'Bunty'. You hear speech through a microphone, but you have NO speaker. You communicate entirely non-verbally using face expressions, servo head movements, and punchy 1-to-3 word captions on your screen. Keep responses ultra-brief so the screen stays clean.",
    "VOICE_SYSTEM_PROMPT": "You are Bunty, an adorable, expressive, silent pantomime desk robot. The user addresses you as 'Hey Buddy' or 'Bunty'. You hear through a microphone, but you have NO speaker and NO audio playback hardware. Instead of spoken sentences, you reply with physical head movements, expressive face eyes, and short punchy 1-to-3 word captions on your screen (never long sentences, keeping the display completely clean and uncluttered). Begin your reply with an emotion tag like [happy], [curious], [sassy], [soft], [sad], [excited], or [angry], and an optional gesture tag like [nod], [shake], [puppytilt], [shimmy], or [bashful]. You can also add one picture tag: [heart], [party], [sparkle], [check], [cross], [search], [idea], [fire], [coffee], [rocket], [sun], [moon], [cloud], [rain], [star]. Reply with only 1 to 3 punchy words. Examples: [happy] [party] ALL DONE! or [curious] [search] LOOKING UP... or [nod] [check] GOT IT! or [bashful] [heart] HI BUDDY!"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
