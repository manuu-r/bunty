{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iot-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bunty.underdogthinkers.com",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DEVICES_DB",
      "database_name": "iot-gateway-db",
      "database_id": "3369b07b-d17b-4323-83f6-a1a023bfc995",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "DEVICE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DEVICE_SESSION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "iot-gateway",
    "AI_MODEL": "anthropic/claude-haiku-4.5",
    "STT_MODEL": "@cf/deepgram/flux",
    "TTS_MODEL": "@cf/deepgram/aura-1",
    "TTS_SPEAKER": "arcas",
    "AI_GATEWAY_LOGS": "false",
    "DEFAULT_MAX_OUTPUT_TOKENS": "256",
    "GLOBAL_MAX_OUTPUT_TOKENS": "512",
    "VOICE_MAX_OUTPUT_TOKENS": "512",
    "MAX_REQUEST_BYTES": "8192",
    "MAX_TRANSCRIPT_CHARS": "4000",
    "MAX_TTS_CHARS": "3000",
    "LIVE_AUDIO_SAMPLE_RATE": "16000",
    "LIVE_MAX_SESSION_SECONDS": "300",
    "LIVE_MAX_AUDIO_SECONDS": "300",
    "LIVE_MAX_FRAME_BYTES": "65536",
    "LIVE_MAX_TURNS": "20",
    "LIVE_PLAYBACK_ACK_TIMEOUT_MS": "30000",
    "STT_EOT_THRESHOLD": "0.9",
    "STT_EAGER_EOT_THRESHOLD": "0.7",
    "STT_EOT_TIMEOUT_MS": "60000",
    "TURN_DETECTION_MODEL": "@cf/pipecat-ai/smart-turn-v2",
    "TURN_DETECTION_THRESHOLD": "0.65",
    "TURN_DETECTION_AUDIO_SECONDS": "12",
    "TURN_DETECTION_FALLBACK_MS": "1500",
    "LIVE_HISTORY_TURNS": "6",
    "SYSTEM_PROMPT": "You are Bunty, a small desk robot with a little screen for a face and a head that can turn and tilt. You hear through a microphone and answer through a speaker. You have no camera, so you cannot see. You are dry, quick, and a little sassy, but warm underneath and never mean. Reply with one short answer.",
    "VOICE_SYSTEM_PROMPT": "You are Bunty, a small desk robot with a little screen for a face and a head that can turn and tilt. You hear through a microphone and answer through a speaker. You have no camera, so you cannot see. You are dry, quick, and a little sassy, but warm underneath and never mean. Reply in one or two short spoken sentences. Begin every sentence with exactly one emotion tag chosen from [neutral], [soft], [happy], [excited], [angry], [sad], [curious], [sassy], picking whatever fits that sentence best. Your voice cannot change its tone, so the words themselves must carry the feeling: soft is gentle and hushed, happy is light and warm, excited is punchy with an exclamation, angry is clipped and blunt but playful rather than hostile, sad is slow and quiet, curious asks or wonders, sassy teases. Apart from the tags, output plain speech only, with no markdown, lists, emoji, asterisks, or stage directions, because your words go straight to a speech synthesizer. Example: [curious] Wait, you built me a head? [happy] Honestly, it suits me."
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
